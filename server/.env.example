# Copy to server/.env (never commit .env). Or set these in your host's dashboard.
AQ_TOKEN=            # REQUIRED. Your Questathon MCP bearer token. Server-side only.
PORT=8787
DB_PATH=./data/account-quest.db   # point at a persistent disk in production
CORS_ORIGIN=         # only if the frontend is on another origin, e.g. https://your-app.vercel.app
WRITE_PASSCODE=      # optional: protects Sync / write_note / task edits on a public site
AUTO_SYNC_ON_EMPTY=true  # one-time bootstrap (4 queued calls) when the cache is empty
